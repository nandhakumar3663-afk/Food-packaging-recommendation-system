# =====================================================================
# Smart Food Packaging Recommendation System — Environment Variables
# Copy this file to .env for local overrides. Never commit .env to git.
# =====================================================================

# Flask Environment: "development", "production", or "testing"
FLASK_ENV=production

# Flask Secret Key: Use a secure random string in production
# Example generation: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-this-to-a-secure-random-token-in-production

# Database Configuration:
# - Leave unset for local SQLite development (data/packaging_system.db)
# - Set to Render PostgreSQL connection string for production persistence
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.render.com:5432/packaging_db

# Server Binding
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# IoT Telemetry Simulator Configuration
# Target server URL for scripts/simulate_iot.py (local or production)
API_BASE_URL=http://127.0.0.1:5000
