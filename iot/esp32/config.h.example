/**
 * Smart Food Packaging ESP32 Telemetry Firmware Configuration Template.
 * Copy this file to 'config.h' and fill in your local Wi-Fi and server credentials.
 * DO NOT commit 'config.h' with real credentials to version control.
 */

#ifndef SMART_PACKAGING_CONFIG_H
#define SMART_PACKAGING_CONFIG_H

// 1. Wi-Fi Configuration
#define WIFI_SSID           "YOUR_WIFI_SSID"
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"

// 2. Recommendation Backend Server
#define SERVER_HOST         "192.168.1.100"   // IP of your computer running Flask
#define SERVER_PORT         5000              // Flask port
#define SERVER_ENDPOINT     "/api/iot/readings"

// 3. Device Identification
#define DEVICE_ID           "ESP32-WAREHOUSE-01"
#define ANALYSIS_ID         1                 // Optional linked packaging recommendation analysis ID (or 0 if unassigned)

// 4. Operational Timing
#define TELEMETRY_INTERVAL_MS 10000           // Ingest interval: 10 seconds
#define WIFI_RETRY_INTERVAL_MS 5000           // Retry Wi-Fi every 5s if disconnected
#define MAX_OFFLINE_BUFFER     50             // Max readings to buffer locally when network drops

// 5. Sensor Selection Flags
#define USE_DHT22_SENSOR      1               // 1 = Enable DHT22 on DHT_PIN, 0 = Disable
#define DHT_PIN               4               // GPIO4 (D4) for DHT22 Data line
#define USE_CO2_SENSOR        0               // 0 = CO2 sensor unavailable (sends null), 1 = Enabled
#define CO2_ANALOG_PIN        34              // Analog pin for CO2 sensor if enabled

#endif // SMART_PACKAGING_CONFIG_H
